# AvabodhAI — environment configuration reference.
#
# Copy this file to .env (repo root) and fill in the REQUIRED values.
# Everything else has a working default — override only what you need to
# change. This file is loaded by config/settings.py; it is NOT baked into
# the Docker image (see .dockerignore) and is NEVER read in a deployed
# container unless you explicitly mount/copy one in — real deployments set
# these as actual environment variables instead, per environment
# (dev/staging/prod each get their own values, never shared).

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────

# OpenAI — powers embeddings, summarisation, chat, and image captioning.
# The app refuses to start without this (main.py lifespan check).
OPENAI_API_KEY=

# Postgres — document registry (Document, ChatThread, ChatMessage tables).
# Must be an instance YOU provision (not Docker-managed — see
# scripts/init_schema.py) and separate from clariona-core's own database,
# even if reachable on the same network.
DB_HOST=
DB_PORT=5432
DB_NAME=avabodh
DB_USER=postgres
DB_PASSWORD=
# CHANGE before any real deployment — this is the restricted role the app
# actually queries through (Row-Level Security applies to this role, not
# DB_USER above). init_db()/scripts/init_schema.py creates it automatically
# using DB_USER's credentials, once.
APP_DB_PASSWORD=CHANGE-ME-app-role-password

# Qdrant — chunk/vector store (avabodh_chunks, avabodh_chat_messages
# collections). Same rule as Postgres: your own instance, not Docker-managed,
# never shared with clariona-core's. Provision with scripts/init_qdrant.py.
QDRANT_URL=

# Signs the document preview file links (GET /documents/{id}/file). The
# code-level default is a public, obviously-fake placeholder — anyone who's
# read this repo can forge preview links until you set a real value here.
SECRET_KEY=CHANGE-ME-to-a-long-random-value

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Postgres tuning / restricted role
# ─────────────────────────────────────────────────────────────────────────
APP_DB_USER=avabodh_app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Qdrant
# ─────────────────────────────────────────────────────────────────────────
QDRANT_API_KEY=
QDRANT_COLLECTION=avabodh_chunks
QDRANT_CHAT_COLLECTION=avabodh_chat_messages

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — LLM / embedding / rerank models
# ─────────────────────────────────────────────────────────────────────────
MAP_MODEL=gpt-4o-mini
REDUCE_MODEL=gpt-4o-mini
# The model that ANSWERS chat questions (separate from MAP_MODEL, which
# only drives ingestion summaries). gpt-4o because answers now carry real
# chart/table images and gpt-4o-mini reads those noticeably worse.
CHAT_MODEL=gpt-4o-mini
# Answer-time sampling temperature. Low, so exact figures and the response
# schema hold; was a hardcoded 0.3.
CHAT_TEMPERATURE=0.1
EMBEDDING_MODEL=text-embedding-3-small
# Must match EMBEDDING_MODEL's real output size (text-embedding-3-small =
# 1536, text-embedding-3-large = 3072) — this becomes the Qdrant dense
# vector dimension at collection-creation time; changing it after
# collections exist requires recreating them.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
VISION_MODEL=gpt-4o
MAP_MAX_TOKENS=512
REDUCE_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3

# Sparse (SPLADE, replacing BM25 2026-08-21) + reranker — both run locally
# via fastembed/ONNX, no API key needed, ~100MB downloaded once (baked into
# the Docker image at build time; downloaded on first use otherwise).
SPARSE_MODEL=prithivida/Splade_PP_en_v1
# NOTE: must be a model fastembed's TextCrossEncoder actually supports.
# bge-reranker-v2-m3 is NOT — pointing at it makes every rerank call fail
# silently and fall back to un-reranked order. See config/settings.py.
RERANK_MODEL=BAAI/bge-reranker-base
SEARCH_CANDIDATES=50
SEARCH_CANDIDATES_MAX=80
# Minimum fused (post-RRF) score a hit must clear — leave blank for no floor
SEARCH_SCORE_THRESHOLD=

# Ollama fallback — used automatically when OPENAI_API_KEY is unset AND an
# Ollama server is reachable at OLLAMA_BASE_URL. Not the primary path; the
# app requires OPENAI_API_KEY to start at all (see REQUIRED section above).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
GROQ_API_KEY=
LLM_PROVIDER=auto

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Chunking / extraction / summary
# ─────────────────────────────────────────────────────────────────────────
MAX_CHUNK_SIZE=3000
MIN_CHUNK_SIZE=100
SUMMARY_LANGUAGE=English
# "hi_res" = layout-detection model + OCR fallback (accurate, slower).
# "fast" = skip both, native-text-layer PDFs only (quick).
UNSTRUCTURED_STRATEGY=hi_res

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — File storage
# ─────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploaded_files
DOCUMENTS_DIR=./documents

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Image pipeline
# ─────────────────────────────────────────────────────────────────────────
# Master switch for INGESTION-TIME GPT-4o Vision transcription of image
# regions (charts/diagrams) and of fallback table crops. true (default) is
# today's behavior. Set false for zero Vision spend during ingestion — text,
# tables and table_html still index normally, but PDF charts/diagrams have no
# searchable text and are dropped rather than indexed, and bare image-file
# uploads are rejected. Does NOT affect a user attaching an image to a chat
# question — that always goes to Vision.
VISION_ENABLED=true
# Hard cap on Vision calls per document. Without it a single scraped page
# can fire dozens of billed gpt-4o calls, and a full-site crawl multiplies
# that by max_pages (a real 30-page e-commerce crawl queued ~270).
# Worst case for a crawl is max_pages x this value.
MAX_IMAGES_PER_DOCUMENT=20
IMAGE_MIN_SIZE_BYTES=5000
IMAGE_MAX_DIMENSION=1024
IMAGE_MAX_WORKERS=4
# On-disk crops of every visual element a document yields (charts, diagrams,
# table regions). These are re-attached as REAL images to the answering LLM
# call, so the model reads exact axis values / cell figures itself instead of
# relying on the prose caption written once at ingestion.
VISUAL_CROPS_DIR=./visual_crops
# Max crops attached to a single answering call. Each is sent at detail="high"
# (multi-tile — a real token cost per image), so this bounds cost/latency
# rather than letting top_k decide.
MAX_ATTACHED_CROPS=6

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Preview links / public URL
# ─────────────────────────────────────────────────────────────────────────
# Preview links (GET /documents/{id}/file) don't expire by default — set a
# number of seconds here to change that (deliberate product decision, see
# utils/signed_link.py).
FILE_LINK_TTL_SECONDS=
# The public origin THIS deployment is reached at. Every document preview
# link is built as:
#     {PUBLIC_BASE_URL}/documents/{id}/file?token=...
#
# SET THIS PER ENVIRONMENT. Leave it blank and the origin is guessed from
# the incoming request, which is correct only for direct local access -
# behind a reverse proxy or load balancer that guess sees the INTERNAL
# address, so every preview link points somewhere a browser cannot reach.
#
#   local dev   PUBLIC_BASE_URL=http://localhost:8000
#   dev         PUBLIC_BASE_URL=https://dev.v2.clariona.ai
#   production  PUBLIC_BASE_URL=https://v2.clariona.ai
#
# No trailing slash (one is stripped anyway). Include the scheme.
# Note: preview links are signed with SECRET_KEY, so each environment
# needs its OWN SECRET_KEY too - sharing one means a link issued by dev
# validates against production.
PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Logging
# ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=avabodh.log

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Phase H hardening (all default to today's exact behavior;
# every one of these is an opt-in tightening, not a breaking change)
# ─────────────────────────────────────────────────────────────────────────
# Comma-separated origin list for browser CORS. "*" (default) matches
# today's behavior for every server-to-server caller (CORS never applies
# to those). Only set allow_credentials=True automatically once you supply
# a real, non-wildcard list here.
CORS_ALLOWED_ORIGINS=*
# Empty (default) = today's exact trust model: X-Tenant-ID/X-Org-Unit-ID
# headers alone, no additional credential — matches clariona-core's
# current calls exactly. Set this to require callers to ALSO send a
# matching X-Service-Key header.
SERVICE_API_KEY=
# false (default) blocks /web/scrape targets that resolve to
# loopback/private/link-local/reserved IPs (SSRF guard). Only flip this if
# you deliberately need to scrape an internal target.
SCRAPER_ALLOW_PRIVATE_NETWORKS=false

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — LangSmith tracing
# ─────────────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Avabodh Project

# ─────────────────────────────────────────────────────────────────────────
# /kb subsystem (api/routes/kb.py, pipeline/kb_pipeline.py) — a SEPARATE,
# out-of-scope feature not touched by the 2026-08-21 Qdrant migration. Uses
# the SAME Postgres instance/credentials above (async engine via
# async_db_url), plus its own PYTHON_KB_INTERNAL_URL default above. No
# additional required vars beyond what's already listed.
# ─────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — S3 storage for uploaded documents
# ─────────────────────────────────────────────────────────────────────────
# Leave S3_BUCKET EMPTY to keep storing uploads on local disk (current
# behaviour, nothing changes). Set it to switch document storage to S3.
# Credentials are shared with clariona-core's AWS account.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_KEY_PREFIX=avabodh/documents
# Only for S3-compatible stores (MinIO etc). Leave blank for real AWS.
STORAGE_S3_ENDPOINT_URL=
# Orphan cleanup only - files are normally deleted when their ingest
# job finishes. Must exceed the slowest ingest; do not lower to minutes.
STORAGE_LOCAL_TTL_HOURS=4
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
